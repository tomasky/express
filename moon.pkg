import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

// Express API names that are reserved words in MoonBit (`method`, `use`) are
// declared with a non-reserved name and re-exported through `#alias`, so the
// package compiles without warning suppressions.

supported_targets = "native"

options(
  // µWebSockets is C++ and header-only; uSockets is vendored C. TLS is
  // compiled in unconditionally so that published builds of this package can
  // serve HTTPS: consumers only add the OpenSSL link flags (-lssl -lcrypto,
  // see example/*/moon.pkg) to their own executable package.
  //
  // Note: only `stub-cc-flags` may appear here — adding `cc-link-flags` to a
  // library package makes `moon build` treat it as an executable to link.
  link: {
    "native": {
      // `-Wno-deprecated-declarations`: the vendored OpenSSL backend of
      // uSockets still uses OpenSSL 1.x APIs (DH_free, PEM_read_DHparams)
      // that OpenSSL 3 marks deprecated; we compile third-party code as-is.
      "stub-cc-flags": "-DMOONBIT_UWS_WITH_TLS -DLIBUS_USE_OPENSSL -Wno-deprecated-declarations",
    },
  },
  "native-stub": [
    "src/uws_shim.cpp",
    "third_party/usockets/src/loop.c",
    "third_party/usockets/src/context.c",
    "third_party/usockets/src/socket.c",
    "third_party/usockets/src/udp.c",
    "third_party/usockets/src/bsd.c",
    "third_party/usockets/src/quic.c",
    "third_party/usockets/src/eventing/epoll_kqueue.c",
    "third_party/usockets/src/crypto/openssl.c",
    "third_party/usockets/src/crypto/sni_tree.cpp",
  ],
)
