import {
  "kupas/express" @lib,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  // The express package compiles in TLS support, so executables link OpenSSL
  // in addition to the C++ and zlib dependencies of µWebSockets.
  link: { "native": { "cc-link-flags": "-lstdc++ -lz -lssl -lcrypto" } },
)
